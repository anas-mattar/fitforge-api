<Project>

  <!-- Applies to every project in this repository, including any added later.
       T010: the gate passes the warnaserror flag on the command line, but a project
       that simply lacks TreatWarningsAsErrors would still pass a build invoked without
       it. Setting it here means a warning is an error however the build is started. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
