<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ADR-001 §4.2: references point one way only —
       Api -> Infrastructure -> Domain -> nothing. Nothing may reference Api.
       TargetFramework, Nullable, ImplicitUsings and TreatWarningsAsErrors are set for
       every project in Directory.Build.props. -->

  <!-- The startup message for a missing connection string tells the developer to run
       'dotnet user-secrets set'. Without this identifier that command exits with
       "Could not find the global property 'UserSecretsId'" - so the message whose whole
       purpose is to save the reader an afternoon cost them one instead. Do not remove it
       when regenerating this file; UserSecretsIdTests asserts it is here. -->
  <PropertyGroup>
    <UserSecretsId>fitforge-api-5f1c9a24-3d47-4a0b-9c2e-8b6d1e0f7a35</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Design-time only, and NOT a new package: already on 001 plan §5 approved
         list for this repository, referenced by FitForge.Infrastructure too. The EF
         tools resolve the DbContext through the STARTUP project, so
         `dotnet ef migrations add` needs it here even though every migration lives
         in Infrastructure (ADR-001 §4.3). PrivateAssets=all keeps it out of the
         published output and out of anything referencing this project.
         It arrives in phase 3 rather than phase 1 because phase 1 Territory did not
         declare this path and scope-check-repos said so - see tasks.md A3. The
         alternative, an IDesignTimeDbContextFactory, was rejected: it reads the
         connection string by a second path that can drift from the host. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FitForge.Domain\FitForge.Domain.csproj" />
    <ProjectReference Include="..\FitForge.Infrastructure\FitForge.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Host wiring is internal — nothing outside this assembly should construct it.
       The tests are the exception: the exception handler is exercised directly so the
       application ships no route that exists only to be thrown from. -->
  <ItemGroup>
    <InternalsVisibleTo Include="FitForge.Api.Tests" />
  </ItemGroup>

</Project>
